{
  "name": "personal-budget-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev": "node scripts/dev.js",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "migrate": "npm run migrate -w server"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.25.12": true
  }
}
